# Papers: imported content and local rendering. Acquisition lives in tool-lit-review.

import '../just/repo-push.just'

[group("papers")]
import-export EXPORT:
    uv run python tools/ingest.py import-export --export {{EXPORT}}

[group("papers")]
render ARXIV_ID:
    uv run python tools/render.py {{ARXIV_ID}}

[group("papers")]
list:
    uv run python tools/ingest.py list

[group("verify")]
test:
    uv run pytest tests/ || echo "No tests yet"

[group("verify")]
fmt:
    uv run ruff format .

[group("verify")]
check:
    uv run ruff check .

[group("verify")]
ci: fmt check test
    @echo "✓ All checks passed"
